{
  "name": "@jjlabsio/create-jjlabs-app",
  "version": "0.5.0",
  "description": "CLI to scaffold a new JJLabs app from the starter template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjlabsio/jjlabsio-starter.git"
  },
  "type": "module",
  "bin": {
    "create-jjlabs-app": "dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "dev:template-app": "node scripts/dev-template-app.mjs",
    "dev:template-admin": "node scripts/dev-template-admin.mjs",
    "dev:template-email": "pnpm --dir template --filter @repo/email exec email dev --dir ./emails --port 4002",
    "test": "vitest run",
    "test:pack-env": "node scripts/check-pack-env.mjs",
    "test:tracked-artifacts": "node scripts/check-pack-env.mjs --tracked",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "prepublishOnly": "pnpm test:pack-env",
    "publish:npm": "pnpm build && npm publish --provenance --access public"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "picomatch": "^4.0.4",
      "postcss": "^8.5.23"
    }
  }
}
