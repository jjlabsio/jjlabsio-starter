# Same database as app; deploy Admin as a separate Next.js project.
DATABASE_URL="postgresql://postgres:postgres@localhost:{{LOCAL_POSTGRES_PORT}}/{{PROJECT_NAME}}?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:{{LOCAL_POSTGRES_PORT}}/{{PROJECT_NAME}}?schema=public"
# Exactly one verified Google email. Empty denies all. Configure your own owner account.
ADMIN_EMAIL=""
# Generate a different secret from apps/app; never share authentication cookies.
BETTER_AUTH_SECRET="replace-with-a-distinct-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:{{LOCAL_ADMIN_PORT}}"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Website containing legal pages
NEXT_PUBLIC_WEB_URL="http://localhost:{{LOCAL_WEB_PORT}}"

# Service-email sending (optional; missing values keep drafting/preview available)
RESEND_API_KEY=""
EMAIL_FROM=""
