# Database (Neon or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:{{LOCAL_POSTGRES_PORT}}/{{PROJECT_NAME}}?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:{{LOCAL_POSTGRES_PORT}}/{{PROJECT_NAME}}?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:{{LOCAL_APP_PORT}}"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Polar Billing (https://polar.sh)
POLAR_ACCESS_TOKEN="pat_xxx"
POLAR_WEBHOOK_SECRET="whs_xxx"
POLAR_ORGANIZATION_ID="org_xxx"
NEXT_PUBLIC_POLAR_PRODUCT_ID_STARTER_MONTHLY="prod_xxx_starter_monthly"
NEXT_PUBLIC_POLAR_PRODUCT_ID_STARTER_YEARLY="prod_xxx_starter_yearly"
# Optional Pro plan checkout
# NEXT_PUBLIC_POLAR_PRODUCT_ID_PRO_MONTHLY="prod_xxx_pro_monthly"
# NEXT_PUBLIC_POLAR_PRODUCT_ID_PRO_YEARLY="prod_xxx_pro_yearly"
NEXT_PUBLIC_POLAR_PRODUCT_ID_PREMIUM_MONTHLY="prod_xxx_premium_monthly"
NEXT_PUBLIC_POLAR_PRODUCT_ID_PREMIUM_YEARLY="prod_xxx_premium_yearly"

# Resend Email (https://resend.com)
RESEND_API_KEY=""
# Set both values to enable email. Use a sender on your verified Resend domain.
EMAIL_FROM=""

# Sentry (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=""

# Website containing legal pages
NEXT_PUBLIC_WEB_URL="http://localhost:{{LOCAL_WEB_PORT}}"
